{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://imd-schemas.local/schemas/topup-1.json",
  "title": "IMD topup-1",
  "description": "schedule.topup input. Any wallet can add runs; schedule existence and state are remote checks.",
  "type": "object",
  "properties": {
    "scheduleId": {
      "$ref": "common-1.json#/$defs/uuid"
    },
    "runs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    }
  },
  "required": [
    "scheduleId",
    "runs"
  ],
  "additionalProperties": false
}
